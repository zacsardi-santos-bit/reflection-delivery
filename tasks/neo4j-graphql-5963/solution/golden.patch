+                        GraphQLFloat.name,
+                        GraphQLString.name,
+                        GraphQLBoolean.name,
+                        GraphQLID.name,
+                        GraphQLBigInt.name,
+                        GraphQLDateTime.name,
+                        GraphQLDate.name,
+                        GraphQLTime.name,
+                        GraphQLLocalDateTime.name,
+                        GraphQLLocalTime.name,
+                        GraphQLDuration.name,
+                    ].includes(getInnerTypeName(fieldDefinitionNode.type))
