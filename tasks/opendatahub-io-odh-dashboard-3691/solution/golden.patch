+const NIMTab: React.FC<NIMTabProps> = ({ model }) => (
+  <Stack data-testid="nim-metrics-loaded">
+    <StackItem>
+      <MetricsPageToolbar />
+    </StackItem>
+    <PageSection hasBodyWrapper={false} isFilled>
+      <NimMetrics modelName={model.metadata.name} />
+    </PageSection>
+  </Stack>
+);
+
+export default NIMTab;
