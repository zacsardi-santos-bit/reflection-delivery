    "test_tell.bats::run '#39;tell'#39; without arguments",
    "test_tell.bats::run '#39;tell'#39; normally",
    "test_tell.bats::run '#39;tell'#39; with '#39;-m'#39;",
    "test_tell.bats::run '#39;tell'#39; with '#39;-m'#39; (empty email)",
    "test_tell.bats::run '#39;tell'#39; with multiple emails",
    "test_tell.bats::run '#39;tell'#39; in subfolder",
