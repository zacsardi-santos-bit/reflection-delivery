@@ -0,0 +1,9 @@
+export default <Key extends string, T extends Record<Key, any>>(
+  source: T,
+  key: Key,
+): Omit<T, Key> => {
+  const copy = { ...source };
+  delete copy[key];
+
+  return copy;
+};
