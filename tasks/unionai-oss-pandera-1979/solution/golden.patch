+                json_schema_input_schema = core_schema.list_schema(
+                    core_schema.typed_dict_schema(
+                        {
+                            key: core_schema.typed_dict_field(
+                                type_map[
+                                    schema_json_columns[key]["items"]["type"]
+                                ]
+                            )
+                            for key in schema.dtypes.keys()
+                        },
+                    )
+                )
+
