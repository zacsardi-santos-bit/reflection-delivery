+        def pydantic_validate(cls, obj: Any, schema_model) -> pl.DataFrame:
+            """
+            Verify that the input can be converted into a polars dataframe that
+            meets all schema requirements.
+
+            This is for pydantic >= v2
+            """
+            try:
