+  }
+  sqs_policies = { for item in data.aws_ssm_parameter.irsa_policy_arns : item.name => item.value }
+  dynamodb_policies = {
+    message_dynamodb  = module.message_dynamodb.irsa_policy_arn,
+    schedule_dynamodb = module.schedule_dynamodb.irsa_policy_arn
+  }
+}
