-	createOpts := servers.CreateOpts{
-		Name:      "server_name",
-		ImageRef:  "image-uuid",
-		FlavorRef: "flavor-uuid",
-	}
-
-	server, err := servers.Create(computeClient, createOpts).Extract()
-	if err != nil {
-		panic(err)
-	}
-
-Example to Delete a Server
