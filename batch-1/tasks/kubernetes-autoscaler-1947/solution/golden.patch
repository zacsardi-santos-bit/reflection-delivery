-		panic(err)
-	}
-
-Example to Delete a Network
-
-	networkID := "484cda0e-106f-4f4b-bb3f-d413710bbe78"
-	err := networks.Delete(networkClient, networkID).ExtractErr()
-	if err != nil {
-		panic(err)
-	}
-*/
