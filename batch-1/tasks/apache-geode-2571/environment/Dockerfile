FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y \
    git curl ca-certificates patch build-essential \
    openjdk-8-jdk \
    && rm -rf /var/lib/apt/lists/*

ENV JAVA_HOME=/usr/lib/jvm/java-8-openjdk-amd64
ENV PATH=$PATH:$JAVA_HOME/bin

RUN mkdir -p /root/.gradle && printf 'allprojects {\n  tasks.withType(Test) {\n    testLogging {\n      events "passed", "failed", "skipped"\n      exceptionFormat "full"\n    }\n  }\n}\n' > /root/.gradle/init.gradle

WORKDIR /workspace

RUN git init /workspace/repo && cd /workspace/repo && \
    git remote add origin https://github.com/apache/geode.git && \
    git fetch --depth 30 origin 9199a9ef9af684ac20f0f4e0a8b5da6ba9b45d3d && \
    git checkout --detach FETCH_HEAD && \
    git submodule update --init --recursive --depth 1 2>/dev/null || true && \
    git remote remove origin && \
    git tag -l | xargs -r git tag -d && \
    git for-each-ref --format='%(refname)' refs/remotes refs/tags 2>/dev/null | xargs -r -n1 git update-ref -d && \
    git reflog expire --expire=now --all && \
    git gc --prune=now --aggressive && \
    rm -rf .git/logs

WORKDIR /workspace/repo

RUN sed -i '/com.pedjak.gradle.plugins:dockerized-test/d' /workspace/repo/build.gradle && \
    sed -i "/apply plugin: 'com.github.pedjak.dockerized-test'/d" /workspace/repo/gradle/docker.gradle && \
    git config user.email "build@docker.local" && \
    git config user.name "Docker Build" && \
    git add build.gradle gradle/docker.gradle && \
    git commit -m "Remove unavailable dockerized-test SNAPSHOT dependency" && git reset --soft 9199a9ef9af684ac20f0f4e0a8b5da6ba9b45d3d && rm -rf .git/logs .git/refs/original 2>/dev/null

WORKDIR /workspace

# --- terminal-bench eval harness deps (tmux + asciinema), baked for offline eval ---
RUN (command -v tmux >/dev/null 2>&1 && command -v asciinema >/dev/null 2>&1) \
    || (apt-get update && apt-get install -y --no-install-recommends tmux asciinema) \
    || (apt-get update && apt-get install -y --no-install-recommends tmux python3-pip && pip3 install --no-cache-dir asciinema) \
    || (apk add --no-cache tmux asciinema) \
    || (dnf install -y tmux asciinema) \
    || (yum install -y tmux asciinema) \
    || true

# --- offline-harbor: ensure grading(python3) + patch(patch/git) deps (build-time) ---
RUN (command -v python3 >/dev/null 2>&1 && command -v patch >/dev/null 2>&1 && command -v git >/dev/null 2>&1) \
    || (apt-get update && apt-get install -y --no-install-recommends python3 patch git ca-certificates) \
    || (apk add --no-cache python3 patch git ca-certificates) \
    || (dnf install -y python3 patch git ca-certificates) \
    || (yum install -y python3 patch git ca-certificates) \
    || true

# --- offline-harbor: bake Maven deps into ~/.m2 (build-time warm) ---
# Warm the local Maven repo with EXACTLY the deps the oracle (base+test.patch+golden)
# needs, so the test runs offline. Patches are applied only to warm ~/.m2 and are
# REVERTED before the image is finalized (the solution is never baked in).
RUN set -e; \
    printf '%s' "" | base64 -d > /tmp/_warm_sol.patch 2>/dev/null || true; \
    printf '%s' "" | base64 -d > /tmp/_warm_test.patch 2>/dev/null || true; \
    printf '%s' "" | base64 -d > /tmp/_warm_cmd.sh 2>/dev/null || true; \
    cd /workspace/repo && \
    ap() { p="$1"; \
      patch -p1 -d /workspace/repo --fuzz=5 -i "$p" 2>/dev/null && return 0; \
      ( cd /workspace/repo && git apply --3way --ignore-whitespace "$p" ) 2>/dev/null && return 0; \
      ( cd /workspace/repo && git apply --ignore-whitespace --whitespace=nowarn "$p" ) 2>/dev/null && return 0; \
      patch -p0 -d /workspace/repo --fuzz=5 -i "$p" 2>/dev/null && return 0; \
      return 0; }; \
    [ -s /tmp/_warm_sol.patch ] && ap /tmp/_warm_sol.patch || true; \
    [ -s /tmp/_warm_test.patch ] && ap /tmp/_warm_test.patch || true; \
    \
    ( timeout 3300 bash /tmp/_warm_cmd.sh 2>&1 | tail -25 || true ); \
    cd /workspace/repo && \
    ( git checkout -- . >/dev/null 2>&1 || true ); \
    ( git clean -fdq >/dev/null 2>&1 || true ); \
    rm -f /tmp/_warm_sol.patch /tmp/_warm_test.patch /tmp/_warm_cmd.sh; \
    true

# --- login-shell PATH: the client execs the verifier via `bash -lc`, which resets PATH from
# /etc/profile and drops the base-image toolchain (go/cargo/...). Bake the built PATH into
# /etc/profile.d so login shells find the toolchain (matches non-login Modal behavior). ---
RUN printf 'export PATH="%s"\n' "$PATH" > /etc/profile.d/zzz_offline_path.sh && chmod 0644 /etc/profile.d/zzz_offline_path.sh
