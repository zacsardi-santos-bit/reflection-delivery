+fn test_no_restricted_imports_object_config() {
+    use crate::tester::Tester;
+
+    let fail = vec![
+        (
+            r#"import foo from "foo";"#,
+            Some(serde_json::json!([{
+                "name": "foo",
+                "message": "Please import from bar instead."
