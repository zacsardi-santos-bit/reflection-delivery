+	j.caJournalID = caJournal.ID
+	if err := proto.Unmarshal(caJournal.Data, j.entries); err != nil {
+		return nil, errs.New("unable to unmarshal entries from CA journal record: %v", err)
+	}
+	return j, nil
+}
