+	return r.Ids
+}
+
+func (r *Route53CidrCollection) GetAndSetIdentifiers(c context.Context, configObj config.Config) ([]string, error) {
+	identifiers, err := r.getAll(c, configObj)
+	if err != nil {
+		return nil, err
+	}
+
+	r.Ids = awsgo.StringValueSlice(identifiers)
+	return r.Ids, nil
+}
+
+// Nuke - nuke 'em all!!!
