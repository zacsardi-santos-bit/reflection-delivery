+	return "route53-cidr-collection"
+}
+
+func (r *Route53CidrCollection) MaxBatchSize() int {
+	// Tentative batch size to ensure AWS doesn't throttle
+	return 49
+}
+
+// ResourceIdentifiers - The ids of the cidr collections
