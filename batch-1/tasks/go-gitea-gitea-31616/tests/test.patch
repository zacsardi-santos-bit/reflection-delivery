+package svg
+
+import (
+	"os"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+)
+
+func TestNewOcticonsExist(t *testing.T) {
+	newIcons := []string{
+		"octicon-accessibility-inset.svg",
+		"octicon-ai-model.svg",
+		"octicon-bookmark-filled.svg",
+		"octicon-bookmark-slash-fill.svg",
+		"octicon-file-media.svg",
+		"octicon-home-fill.svg",
+		"octicon-tab.svg",
+	}
+	svgDir := "../../public/assets/img/svg"
+	for _, icon := range newIcons {
+		p := svgDir + "/" + icon
+		_, err := os.Stat(p)
+		assert.NoError(t, err, "SVG icon should exist: %s", icon)
+	}
+}
