new file mode 100644
index 0000000..85fba1c
--- /dev/null
+++ b/pkg/inspection/metadata/logger/logger.go
@@ -0,0 +1,204 @@
+// Copyright 2024 Google LLC
+//
+// Licensed under the Apache License, Version 2.0 (the "License");
