+		query: Query{
+			Metrics: []MetricCfg{{
+				MetricName:  "my.int",
+				ValueColumn: "myint",
+				Monotonic:   true,
+				ValueType:   MetricValueTypeInt,
+				DataType:    MetricDataTypeGauge,
+			}},
+		},
+	}
+	_, err := scrpr.Scrape(context.Background())
+	const expected = "scraper.Scrape row conversion errors: row 0: rowToMetric: " +
