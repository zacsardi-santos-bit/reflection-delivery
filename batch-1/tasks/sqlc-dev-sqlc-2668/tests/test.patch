+package golang
+
+import (
+	"testing"
+
+	"github.com/sqlc-dev/sqlc/internal/plugin"
+)
+
+func TestPostgresTypeVarbitPGXV4(t *testing.T) {
+	req := &plugin.CodeGenRequest{
+		Settings: &plugin.Settings{
+			Go: &plugin.GoCode{
+				SqlPackage: SQLPackagePGXV4,
+			},
+		},
+	}
+	col := &plugin.Column{
+		Type: &plugin.Identifier{Name: "varbit"},
+	}
+	got := postgresType(req, col)
+	want := "pgtype.Varbit"
+	if got != want {
+		t.Errorf("got %q, want %q", got, want)
+	}
+}
