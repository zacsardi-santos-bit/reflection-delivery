+
+#[test]
+fn local_variable_ignore_anonymous_function_returned() {
+    let code = "
+pub fn main() {
+  fn(wibble: Int) {
+    let wabble = 1
+    let add_two = fn(wobble: Int) { wobble + 2 }
+    wibble + add_two(1)
+  }
+}
+";
+
+    assert_completion!(TestProject::for_source(code), Position::new(5, 10));
+}
+
+#[test]
+fn local_variable_case_expression() {
