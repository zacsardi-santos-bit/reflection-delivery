+-- This makes segments.collection non-nullable.
+CREATE TABLE segments_temp (
+    id TEXT PRIMARY KEY,
+    type TEXT NOT NULL,
+    scope TEXT NOT NULL,
+    collection TEXT REFERENCES collection(id) NOT NULL
