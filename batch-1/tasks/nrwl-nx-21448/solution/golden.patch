diff --git a/packages/playwright/src/migrations/update-17-3-1/add-project-to-config.ts b/packages/playwright/src/migrations/update-17-3-1/add-project-to-config.ts
new file mode 100644
index 0000000000..b48ec74f1c
--- /dev/null
