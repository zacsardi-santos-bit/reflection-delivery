+fn validate_field(mut field: &Positioned<Field>) -> Result<(), String> {
+    loop {
+        match field.node.selection_set.node.items.as_slice() {
+            [] => return Ok(()),
+            [item] => match &item.node {
+                engine_parser::types::Selection::Field(inner_field) => {
