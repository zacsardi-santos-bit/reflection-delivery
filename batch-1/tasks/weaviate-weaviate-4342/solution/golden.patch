+#include <immintrin.h>
+
+void dot_512(float *a, float *b, float *res, long *len)
+{
+    int n = *len;
+    float sum = 0;
+
+    // fast path for small dimensions
+    if (n < 8)
+    {
+        do
+        {
+            sum += a[0] * b[0];
+            n--;
+            a++;
+            b++;
+        } while (n);
+
+        *res = sum;
+        return;
+    }
+
