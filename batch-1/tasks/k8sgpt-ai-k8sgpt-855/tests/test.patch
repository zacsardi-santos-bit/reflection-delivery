+package integration_test
+
+import (
+	"testing"
+
+	"github.com/k8sgpt-ai/k8sgpt/pkg/integration"
+	"github.com/stretchr/testify/require"
+)
+
+func TestGetPrometheusIntegration(t *testing.T) {
+	i := integration.NewIntegration()
+	p, err := i.Get("prometheus")
+	require.NoError(t, err)
+	require.NotNil(t, p)
+}
+
+func TestListIntegrations(t *testing.T) {
+	i := integration.NewIntegration()
+	list := i.List()
+	require.Contains(t, list, "prometheus")
+}
