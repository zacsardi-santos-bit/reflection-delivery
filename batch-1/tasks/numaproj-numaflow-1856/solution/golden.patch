+func (pls *PipelineStatus) IsHealthy() bool {
+	switch pls.Phase {
+	case PipelinePhaseFailed:
+		return false
+	case PipelinePhaseRunning:
+		return pls.IsReady()
+	case PipelinePhaseDeleting, PipelinePhasePausing:
