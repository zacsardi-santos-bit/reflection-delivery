+use lopdf::encryption::Permissions;
+
+#[test]
+fn test_printable_permission_bit() {
+    assert_eq!(Permissions::PRINTABLE.bits(), 4);
+}
+
+#[test]
+fn test_modifiable_permission_bit() {
+    assert_eq!(Permissions::MODIFIABLE.bits(), 8);
+}
+
+#[test]
+fn test_copyable_permission_bit() {
+    assert_eq!(Permissions::COPYABLE.bits(), 16);
+}
+
+#[test]
+fn test_fillable_permission_bit() {
+    assert_eq!(Permissions::FILLABLE.bits(), 256);
+}
