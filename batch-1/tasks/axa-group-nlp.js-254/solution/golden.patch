+            const accuracy = 0.95;
+            const edge = {
+              start: entity.start,
+              end: entity.end,
+              len: entity.end - entity.start + 1,
+              accuracy,
+              sourceText: text,
+              utteranceText: text,
+              entity: entityName,
+            };
+            const resolution = this.calculateResolution(entity, language);
+            if (resolution) {
+              edge.resolution = resolution;
+            }
+            result.push(edge);
+          }
+        }
+      } catch (ex) {
+        //
+      }
+    });
