+      'timezone',
+      'boolean',
+      'duration',
+    ];
+    this.builtinWhitelist = {};
+    for (let i = 0; i < list.length; i += 1) {
+      this.builtinWhitelist[list[i]] = true;
+    }
+    list = this.settings.builtinBlacklist || [];
+    for (let i = 0; i < list.length; i += 1) {
