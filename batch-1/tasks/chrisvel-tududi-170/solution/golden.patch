+                                                : 'text-gray-900 dark:text-gray-100'
+                                        }`}
+                                    >
+                                        {subtask.name}
+                                    </span>
+                                </div>
+
+                                {/* Right side - Status indicator */}
+                                <div className="flex items-center space-x-1">
+                                    {subtask.status === 'done' ||
+                                    subtask.status === 2 ||
+                                    subtask.status === 'archived' ||
