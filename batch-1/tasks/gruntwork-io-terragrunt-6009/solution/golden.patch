-				case msg := <-msgCh:
-					progress = true
-
-					if !apply(msg) {
-						return false
-					}
-
-					continue
-				default:
-				}
-
-				break
-			}
-
-			if !progress {
-				return true
-			}
-		}
-	}
-
-	quit := false
-
-	for _, msg := range interact {
-		if !step() {
-			quit = true
-			break
-		}
-
-		if !apply(msg) {
-			quit = true
-			break
-		}
-	}
-
-	if !quit {
-		step()
-	}
-
