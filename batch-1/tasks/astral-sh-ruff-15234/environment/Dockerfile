FROM rust:1.83

RUN apt-get update && apt-get install -y \
    git ca-certificates python3 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

RUN git init /workspace/repo && cd /workspace/repo && \
    git remote add origin https://github.com/astral-sh/ruff.git && \
    git fetch --depth 30 origin 706d87f239cb3af6562581d221bf6cd1f1636b66 && \
    git checkout --detach FETCH_HEAD && \
    git submodule update --init --recursive --depth 1 2>/dev/null || true && \
    git remote remove origin && \
    git tag -l | xargs -r git tag -d && \
    git for-each-ref --format='%(refname)' refs/remotes refs/tags 2>/dev/null | xargs -r -n1 git update-ref -d && \
    git reflog expire --expire=now --all && \
    git gc --prune=now --aggressive && \
    rm -rf .git/logs

WORKDIR /workspace/repo

RUN cargo fetch

RUN cargo test --no-run -p ruff_linter 2>&1 | tail -10

RUN cat > /workspace/run_cargo_test.py << 'PYEOF'
import subprocess
import sys
import re
import os

env = os.environ.copy()
env['INSTA_UPDATE'] = 'no'

result = subprocess.run(
    ["cargo", "test", "-p", "ruff_linter", "ruf057"],
    stdout=subprocess.PIPE,
    stderr=subprocess.STDOUT,
    text=True,
    cwd="/workspace/repo",
    env=env
)

output = result.stdout
test_passed = re.findall(r"^test (.+) \.\.\. ok$", output, re.MULTILINE)
test_failed = re.findall(r"^test (.+) \.\.\. FAILED$", output, re.MULTILINE)

for name in test_passed:
    print("    PASS [   0.01s] ruff_linter " + name)
for name in test_failed:
    print("    FAIL [   0.01s] ruff_linter " + name)

if not test_passed and not test_failed:
    sys.stdout.write(output)

sys.exit(result.returncode)
PYEOF

WORKDIR /workspace

# --- terminal-bench eval harness deps (tmux + asciinema), baked for offline eval ---
RUN (command -v tmux >/dev/null 2>&1 && command -v asciinema >/dev/null 2>&1) \
    || (apt-get update && apt-get install -y --no-install-recommends tmux asciinema) \
    || (apt-get update && apt-get install -y --no-install-recommends tmux python3-pip && pip3 install --no-cache-dir asciinema) \
    || (apk add --no-cache tmux asciinema) \
    || (dnf install -y tmux asciinema) \
    || (yum install -y tmux asciinema) \
    || true

# --- offline-harbor: ensure grading(python3) + patch(patch/git) deps (build-time) ---
RUN (command -v python3 >/dev/null 2>&1 && command -v patch >/dev/null 2>&1 && command -v git >/dev/null 2>&1) \
    || (apt-get update && apt-get install -y --no-install-recommends python3 patch git ca-certificates) \
    || (apk add --no-cache python3 patch git ca-certificates) \
    || (dnf install -y python3 patch git ca-certificates) \
    || (yum install -y python3 patch git ca-certificates) \
    || true

# >>> offline-cargo-bake (new4261) >>>
# Warm $CARGO_HOME for the EXACT post-golden+test dependency graph, then revert
# the working tree so only the crate cache is baked (never the solution).
RUN printf %s '' | base64 -d | gzip -d > /tmp/__golden.patch
RUN printf %s '' | base64 -d > /tmp/__test.patch
RUN set -u; cd /workspace/repo; \
    apply_one() { pf="$1"; [ -s "$pf" ] || return 0; \
      patch -p1 -i "$pf" 2>/dev/null && return 0; \
      git apply --3way --ignore-whitespace "$pf" 2>/dev/null && return 0; \
      git apply --ignore-whitespace --whitespace=nowarn "$pf" 2>/dev/null && return 0; \
      patch -p1 --fuzz=5 -i "$pf" 2>/dev/null && return 0; \
      git ls-files -z 2>/dev/null | xargs -0 -r sed -i 's/\r$//' 2>/dev/null; \
      git apply --3way --ignore-whitespace "$pf" 2>/dev/null && return 0; \
      patch -p1 --fuzz=5 -i "$pf" 2>/dev/null && return 0; \
      return 0; }; \
    apply_one /tmp/__golden.patch; \
    apply_one /tmp/__test.patch; \
    (cargo fetch 2>&1 | tail -3 || true); \
    (cargo build --tests 2>&1 | tail -5 || true); \
    (cargo test --no-run 2>&1 | tail -5 || true); \
    (cargo nextest run --no-run 2>&1 | tail -5 || true); \
    git checkout -- . 2>/dev/null || true; \
    git clean -fdq 2>/dev/null || true; \
    rm -f /tmp/__golden.patch /tmp/__test.patch
ENV CARGO_NET_OFFLINE=true
# <<< offline-cargo-bake (new4261) <<<

# --- login-shell PATH: the client execs the verifier via `bash -lc`, which resets PATH from
# /etc/profile and drops the base-image toolchain (go/cargo/...). Bake the built PATH into
# /etc/profile.d so login shells find the toolchain (matches non-login Modal behavior). ---
RUN printf 'export PATH="%s"\n' "$PATH" > /etc/profile.d/zzz_offline_path.sh && chmod 0644 /etc/profile.d/zzz_offline_path.sh
