+#[test]
+fn test_casm_contract_has_bytecode_segment_lengths() {
+    let contract_class = get_test_contract(
+        "cairo_level_tests::contracts::minimal_contract::minimal_contract",
+    );
+    let add_pythonic_hints = true;
+    let casm_contract =
+        CasmContractClass::from_contract_class(contract_class, add_pythonic_hints).unwrap();
+    assert!(
+        casm_contract.bytecode_segment_lengths.is_some(),
+        "Expected bytecode_segment_lengths to be present for sierra >= 1.5"
+    );
+}
