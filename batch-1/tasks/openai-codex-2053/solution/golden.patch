+        create: (...args: Array<any>) => {
+          if (args[0]?.stream) {
+            return openAiState.createStreamSpy!(...args);
+          }
+          return openAiState.createSpy!(...args);
+        },
+      },
+    };
+  }
+
+  return {
+    __esModule: true,
+    default: FakeOpenAI,
+  };
+});
