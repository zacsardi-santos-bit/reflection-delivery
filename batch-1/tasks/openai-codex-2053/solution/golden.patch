+import { describe, it, expect } from "vitest";
+
+// Helper to send keystrokes and wait for Ink's async timing so that the frame
+// reflects the input.
+async function type(
+  stdin: NodeJS.WritableStream,
+  text: string,
+  flush: () => Promise<void>,
+) {
+  stdin.write(text);
+  await flush();
+}
+
