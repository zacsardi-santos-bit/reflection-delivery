+type OutputTextDeltaEvent = Extract<
+  ResponseEvent,
+  { type: "response.output_text.delta" }
+>;
+type OutputTextDoneEvent = Extract<
+  ResponseEvent,
+  { type: "response.output_text.done" }
+>;
+type ResponseCompletedEvent = Extract<
+  ResponseEvent,
+  { type: "response.completed" }
+>;
