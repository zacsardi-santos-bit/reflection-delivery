+
+test("process_patch - invalid patch throws DiffError", () => {
+  const patch = `*** Begin Patch
+*** Update File: missing.txt
+@@
++something
+*** End Patch`;
+
+  const fs = createInMemoryFS({});
+
+  expect(() =>
+    process_patch(patch, fs.openFn, fs.writeFn, fs.removeFn),
+  ).toThrow(DiffError);
