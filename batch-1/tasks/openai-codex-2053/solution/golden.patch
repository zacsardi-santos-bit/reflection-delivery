+
+// Create a state holder for our mocks
+const openAiState = {
+  createSpy: vi.fn(),
+};
+
+// Mock the OpenAI client
+vi.mock("openai", () => {
+  return {
+    default: class MockOpenAI {
+      responses = {
+        create: openAiState.createSpy,
+      };
+    },
+  };
+});
+
+describe("Agent interrupt and continue", () => {
+  beforeEach(() => {
+    vi.useFakeTimers();
+  });
+
+  afterEach(() => {
+    vi.useRealTimers();
+    vi.resetAllMocks();
+  });
+
+  it("allows continuing after interruption", async () => {
