+++ b/codex-cli/src/components/vendor/ink-select/use-select.js
@@ -0,0 +1,17 @@
+import { useInput } from "ink";
+export const useSelect = ({ isDisabled = false, state }) => {
+  useInput(
+    (_input, key) => {
+      if (key.downArrow) {
+        state.focusNextOption();
+      }
+      if (key.upArrow) {
+        state.focusPreviousOption();
+      }
+      if (key.return) {
+        state.selectFocusedOption();
+      }
+    },
+    { isActive: !isDisabled },
+  );
+};
