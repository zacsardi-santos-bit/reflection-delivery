+      };
+
+      while (turnInput.length > 0) {
+        if (this.canceled || this.hardAbort.signal.aborted) {
+          this.onLoading(false);
+          return;
+        }
+        // send request to openAI
+        // Only surface the *new* input items to the UI – replaying the entire
