+      // Flush staged items if the run concluded successfully (i.e. the user did
+      // not invoke cancel() or terminate() during the turn).
+      const flush = () => {
+        if (
+          !this.canceled &&
+          !this.hardAbort.signal.aborted &&
+          thisGeneration === this.generation
