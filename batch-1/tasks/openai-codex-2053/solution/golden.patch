+    Box,
+    { ...styles.option({ isFocused }) },
+    isFocused &&
+      React.createElement(
+        Text,
+        { ...styles.focusIndicator() },
+        figures.pointer,
+      ),
+    React.createElement(
+      Text,
+      { ...styles.label({ isFocused, isSelected }) },
+      children,
