+  count=$(get_value_from "${lines[0]}" '.Reports | length')
+
+  [[ "${message1}" == "StatefulSet: StatefulSet's VolumeClaimTemplate is missing required annotation: required-annotation" ]]
+  [[ "${failing_resource}" == "bad-sts" ]]
+  [[ "${count}" == "1" ]]
+}
+
