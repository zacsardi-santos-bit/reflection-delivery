+use nostr::prelude::*;
+
+#[test]
+fn test_nip05_profile_from_json() {
+    let json = r#"{
+  "names": {
+    "0xtr": "b2d670de53b27691c0c3400225b65c35a26d06093bcc41f48ffc71e0907f9d4a"
+  }
+}"#;
+    let address = Nip05Address::parse("0xtr@oxtr.dev").unwrap();
+    let profile = Nip05Profile::from_raw_json(&address, json).unwrap();
+    let expected = PublicKey::from_hex("b2d670de53b27691c0c3400225b65c35a26d06093bcc41f48ffc71e0907f9d4a").unwrap();
+    assert_eq!(profile.public_key, expected);
+}
