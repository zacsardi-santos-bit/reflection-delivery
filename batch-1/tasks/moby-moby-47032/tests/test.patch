+package client
+
+import (
+	"testing"
+
+	"go.opentelemetry.io/contrib/instrumentation/net/http/httptrace/otelhttptrace"
+)
+
+func TestOtelHTTPTraceVersion(t *testing.T) {
+	const want = "0.45.0"
+	got := otelhttptrace.Version()
+	if got != want {
+		t.Errorf("otelhttptrace.Version() = %q; want %q", got, want)
+	}
+}
