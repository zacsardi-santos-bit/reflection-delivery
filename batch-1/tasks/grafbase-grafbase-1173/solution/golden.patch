+pub struct Change {
+    // /!\ The order of fields matters for the PartialOrd derive /!\
+    pub path: String,
+    pub kind: ChangeKind,
+}
+
+#[derive(Copy, Clone, Eq, PartialEq, Hash, Ord, PartialOrd, Debug)]
+#[cfg_attr(feature = "serde", derive(serde::Serialize, serde::Deserialize))]
