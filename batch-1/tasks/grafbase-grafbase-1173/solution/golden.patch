+pub enum ChangeKind {
+    // /!\ The order of variants matters for the PartialOrd derive /!\
+    ChangeQueryType,
+    ChangeMutationType,
+    ChangeSubscriptionType,
+    RemoveObjectType,
+    AddObjectType,
+    AddInterfaceImplementation,
+    RemoveInterfaceImplementation,
+    ChangeFieldType,
