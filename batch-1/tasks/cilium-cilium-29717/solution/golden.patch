+// Get name from /proc/(pid)/comm or /proc/(pid)/status
+func (p *Process) fillNameWithContext(ctx context.Context) error {
+	err := p.fillFromCommWithContext()
+	if err == nil && p.name != "" && len(p.name) < 15 {
+		return nil
