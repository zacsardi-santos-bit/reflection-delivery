+		<-k.networkPoliciesStoreSet
+		return k.networkpolicyStore
+	case "pod":
+		// Wait for podStore to get initialized.
+		<-k.podStoreSet
+		// Access to podStore is protected by podStoreMU.
+		k.podStoreMU.RLock()
+		defer k.podStoreMU.RUnlock()
+		return k.podStore
+	default:
+		panic("no such store: " + name)
+	}
