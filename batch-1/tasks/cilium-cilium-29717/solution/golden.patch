+func limitToUint(val string) (uint64, error) {
+	if val == "unlimited" {
+		return math.MaxUint64, nil
+	}
+	res, err := strconv.ParseUint(val, 10, 64)
+	if err != nil {
+		return 0, err
+	}
+	return res, nil
+}
