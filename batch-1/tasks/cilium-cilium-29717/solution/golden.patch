+	IFT_HF          = 0x3d /* Support for PERCS HFI*/
+	IFT_CLUSTER     = 0x3e /* cluster pseudo network interface */
+	IFT_FB          = 0xc7 /* IP over Infiniband. Number by IANA */
+)
+
+type NetIfaceTotal struct {
