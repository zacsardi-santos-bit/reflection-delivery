-	neighMetadata := r.getMetadata(i)
-
-	peers, exists := neighMetadata[instanceName]
-	if !exists {
-		neighMetadata[instanceName] = []*PeerData{d}
-		return
-	}
-
-	found := false
-	for i, p := range peers {
-		if p.Peer.Name == d.Peer.Name {
-			peers[i] = d
-			found = true
-			break
-		}
-	}
-
-	if !found {
