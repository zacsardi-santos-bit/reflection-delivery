+// Get name from /proc/(pid)/comm
+func (p *Process) fillFromCommWithContext() error {
+	pid := p.Pid
+	statPath := common.HostProc(strconv.Itoa(int(pid)), "comm")
+	contents, err := ioutil.ReadFile(statPath)
