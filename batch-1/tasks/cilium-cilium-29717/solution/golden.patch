+	case SC_THREAD_STACK_MIN:
+		return _PTHREAD_STACK_MIN, nil
+	case SC_THREAD_THREADS_MAX:
+		return -1, nil
+	case SC_TIMER_MAX:
+		return -1, nil
+	case SC_TTY_NAME_MAX:
+		return _TTY_NAME_MAX, nil
+	case SC_TZNAME_MAX:
+		return -1, nil
+
+	case SC_CPUTIME:
