+	fs := make([]FileSystem, nmounts)
+	for i := 0; i < int(nmounts); i++ {
+		f := C.get_filesystem_stat(fsinfo, C.int(i))
+		if f != nil {
+			fs[i] = fsinfo2filesystem(f)
+		}
+	}
