+	case SC_NPROCESSORS_ONLN:
+		if val, err := unix.SysctlUint32("hw.ncpu"); err == nil {
+			return int64(val), nil
+		}
+		return -1, nil
+	}
+
+	return sysconfGeneric(name)
+}
