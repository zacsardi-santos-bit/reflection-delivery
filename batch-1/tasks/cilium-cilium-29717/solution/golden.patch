@@ -0,0 +1,911 @@
+//go:build linux
+// +build linux
+
+package net
+
+import (
+	"bytes"
+	"context"
+	"encoding/hex"
+	"errors"
+	"fmt"
+	"io"
+	"io/ioutil"
+	"net"
