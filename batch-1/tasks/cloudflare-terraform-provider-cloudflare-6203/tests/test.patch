-func testAccCloudflarePageRuleMigrationConfigV4Basic(zoneID, target, rnd string) string {
-	return fmt.Sprintf(`
-resource "cloudflare_page_rule" "%[3]s" {
-  zone_id  = "%[1]s"
-  target   = "%[2]s"
-  status   = "active"
-  priority = 1
-
-  actions {
-    ssl = "flexible"
-  }
-}`, zoneID, target, rnd)
-}
-
