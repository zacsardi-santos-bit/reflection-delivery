+	item: InternalSidebarLinkItem,
+	locale: string | undefined,
+	currentPathname: string
+) {
+	let slugWithLocale = locale ? locale + '/' + item.slug : item.slug;
+	// Astro passes root `index.[md|mdx]` entries with a slug of `index`
