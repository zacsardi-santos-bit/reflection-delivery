+package com.baeldung.currencyconverter;
+
+import com.baeldung.currencyconverter.dto.ExchangeRateResponse;
+import org.junit.jupiter.api.Test;
+import static org.junit.jupiter.api.Assertions.*;
+
+public class ExchangeRateResponseUnitTest {
+
+    @Test
+    void testDefaultGettersReturnNull() {
+        ExchangeRateResponse response = new ExchangeRateResponse();
+        assertNull(response.getBase());
+        assertNull(response.getRates());
+    }
+
+    @Test
+    void testSettersAndGetters() {
+        ExchangeRateResponse response = new ExchangeRateResponse();
+        response.setBase("USD");
+        assertEquals("USD", response.getBase());
+    }
+}
