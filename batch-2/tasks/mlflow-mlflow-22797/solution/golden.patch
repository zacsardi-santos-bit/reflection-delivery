-| o3                |     50 |       25,253 |        10,866 |       0.14 |            6 |
-| claude-opus-4-6   |     50 |       44,219 |         7,935 |       0.42 |            6 |
-| claude-sonnet-4-6 |     50 |       45,139 |         7,837 |       0.25 |            8 |
-| gemini-3.1-pro    |     50 |       22,537 |         2,732 |       0.08 |            5 |
