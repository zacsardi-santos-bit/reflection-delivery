-): Promise<string> {
-  return new Promise((resolvePromise) => {
-    const ask = (): void => {
-      rl.question(`  ${label} ${dim(`[${defaultValue}]`)} `, (answer) => {
-        const value = answer.trim() || defaultValue;
-        const err = validate?.(value);
-        if (err) {
-          console.error(`  ${FAIL} ${err}`);
-          ask();
-          return;
-        }
-        resolvePromise(value);
-      });
-    };
-    ask();
-  });
-}
