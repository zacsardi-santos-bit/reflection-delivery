+    link_span_bytes = bytes.fromhex("aabbccddeeff0011")
+    proto_link = otel_proto.links.add()
+    proto_link.trace_id = link_trace_bytes
+    proto_link.span_id = link_span_bytes
+    link_attr = proto_link.attributes.add()
