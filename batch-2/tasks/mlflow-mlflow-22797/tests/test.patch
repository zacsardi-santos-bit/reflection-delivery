+    assert mlflow_span.links[0].attributes == {"type": "causal"}
+
+    rt = mlflow_span.to_otel_proto()
+    assert rt.links[0].trace_id == link_trace_bytes
+    assert rt.links[0].span_id == link_span_bytes
