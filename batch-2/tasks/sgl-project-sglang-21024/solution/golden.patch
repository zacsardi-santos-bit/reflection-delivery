+
+            target_job = None
+            for job in jobs_data.get("jobs", []):
+                if job.get("name", "") == job_name:
+                    target_job = job
+                    break
+
+            if not target_job:
+                return None
+
+            logs_url = f"{self.base_url}/repos/{self.repo}/actions/jobs/{target_job['id']}/logs"
+            response = self.session.get(logs_url)
+            response.raise_for_status()
