+    def _get_sequential_runs(self, limit: int) -> List[Dict]:
+        """Original sequential method for smaller limits"""
+        print(f"Using sequential sampling for {limit} runs...")
+
+        pr_test_runs = []
+        page = 1
+        per_page = 100
+
+        while len(pr_test_runs) < limit:
