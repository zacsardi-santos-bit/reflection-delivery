+        # `after_model` / `before_model` hooks remain a backstop for
+        # non-streaming consumers.
+        if self.apply_to_output or self.apply_to_tool_results:
+            self.transformers = (
+                partial(
+                    _PIIStreamTransformer,
+                    rule=self._resolved_rule,
+                ),
+            )
+
     @property
     def name(self) -> str:
         """Name of the middleware."""
