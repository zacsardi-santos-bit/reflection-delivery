-   */
-  async updateTask(
-    id: string,
-    updates: Partial<TrackerTask>,
-  ): Promise<TrackerTask> {
-    const task = await this.getTask(id);
-    if (!task) {
-      throw new Error(`Task with ID ${id} not found.`);
-    }
-
-    const updatedTask = { ...task, ...updates };
-
-    // Validate status transition if closing
-    if (
