+        base_labels = {
+            "prefect.io/flow-run-id": str(flow_run_id),
+            "prefect.io/flow-run-name": "my-flow-run",
+        }
+
+        # Step 1: CrashLoopBackOff
+        await _replicate_pod_event(
+            event={"type": "MODIFIED"},
+            uid=pod_uid,
+            name="test-pod",
+            namespace="default",
+            labels=base_labels,
