+    if (k >= N) {free(yp); return -3;}     /* sum did not converge */
+    *yptr = yp0;
+
+    yp1 = 0.0;
+    k = 0;
+    yptr -= stridey;        /* Initialize in next-to-last slot in output array */
+    xptr = x + (N-1)*stridex;
+    do {
+	*yptr = yp1;
