+                .context()
+                .comments()
+                .dangling_comments(self.node.syntax())
+                .is_empty()
+            && f.context()
+                .comments()
+                .dangling_comments(self.node.syntax())
+                .iter()
+                .all(|comment| comment.kind().is_inline() && comment.lines_before() == 0)
