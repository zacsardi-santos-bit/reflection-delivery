-    writes: list[Instruction],
-) -> AsyncGenerator[None]:
-    """Auto setup integration."""
-    read_queue.put_nowait(
-        _channel_muting_status(
-            front_right=status.ChannelMuting.Param.ON,
-            center=status.ChannelMuting.Param.ON,
-        )
