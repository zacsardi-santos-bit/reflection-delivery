+// I want an enumeration with values for the second byte of 2-byte opcodes.
+enum OPCODE_2BYTE {
+#define OPDEF(c,s,pop,push,args,type,l,s1,s2,ctrl) TWOBYTE_##c = unsigned(s2),
+#include "opcode.def"
+#undef OPDEF
+};
