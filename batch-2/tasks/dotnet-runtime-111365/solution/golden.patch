-        lb   t3, 0(t4)
-        li   t5, 0xFF
-        beq  t3, t5, 0f
-
-        li   t3, 0xFF
-        sb   t3, 0(t4)
-
-#ifdef FEATURE_MANUALLY_MANAGED_CARD_BUNDLES
-        // Check if we need to update the card bundle table
-        la    t3, g_card_bundle_table
-        srai t5, \destReg, 21
