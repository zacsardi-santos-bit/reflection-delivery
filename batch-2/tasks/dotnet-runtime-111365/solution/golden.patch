@@ -0,0 +1,12812 @@
+// Licensed to the .NET Foundation under one or more agreements.
+// The .NET Foundation licenses this file to you under the MIT license.
+
+//
+#include "common.h"
+
+#ifdef FEATURE_INTERPRETER
+
+#include "interpreter.h"
+#include "interpreter.hpp"
+#include "cgencpu.h"
+#include "stublink.h"
+#include "openum.h"
