+            OpStackSet<T>(opidx, static_cast<T>(d));
+        }
+        break;
+
+    case CORINFO_TYPE_BYREF:
+    case CORINFO_TYPE_CLASS:
+    case CORINFO_TYPE_STRING:
+        if (!TCanHoldPtr)
+        {
+            VerificationError("Conversion of pointer value to type that can't hold its value.");
