-        la    t3, g_ephemeral_low
-        ld    t3, 0(t3)
-        blt  \refReg, t3, 0f
-
-        la    t3, g_ephemeral_high
-        ld    t3, 0(t3)
-        bgeu \refReg, t3, 0f
-
-        // Set this object's card, if it has not already been set.
-        la    t3, g_card_table
-        srai t5, \destReg, 11
-        add  t4, t3, t5
-
-        // Check that this card has not already been written. Avoiding useless writes is a big win on
