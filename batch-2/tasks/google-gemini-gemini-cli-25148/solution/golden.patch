+  if (
+    !config.isTrustedFolder() &&
+    (await patchTargetsProjectSkills(
+      validatedHeaders.patches.map((patch) => patch.targetPath),
+      config,
+    ))
+  ) {
+    return {
+      success: false,
+      message:
+        'Project skill patches are unavailable until this workspace is trusted.',
+    };
+  }
