+    return {
+      success: false,
+      message:
+        validatedHeaders.reason === 'missingTargetPath'
+          ? `Patch "${fileName}" is missing a target file path.`
+          : `Patch "${fileName}" has invalid diff headers.`,
+    };
+  }
