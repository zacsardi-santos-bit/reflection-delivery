+    monkeypatch.setattr("sys.pycache_prefix", str(prefix))
+
+    notebook = tmp_path / "project" / "notebook.py"
+    notebook.parent.mkdir(parents=True)
+    notebook.touch()
+
+    # Image at the relocated path.
