-export function buildThemeSection(
-  activeTheme: ThemeConfig,
-  availableThemes: ThemeConfig[],
-  setTheme: (theme: ThemeConfig) => void,
-  metricsMgr: MetricsManager
-): MenuSection {
-  // Hide when there is nothing to switch between.
