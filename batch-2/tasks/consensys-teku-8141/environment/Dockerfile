FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
ENV GRADLE_USER_HOME=/root/.gradle
ENV GRADLE_MAX_TEST_FORKS=1

RUN apt-get update && apt-get install -y \
    openjdk-17-jdk git curl ca-certificates patch wget \
    && rm -rf /var/lib/apt/lists/*

ENV JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64
ENV PATH=$JAVA_HOME/bin:$PATH

WORKDIR /workspace

RUN git init /workspace/repo && cd /workspace/repo && \
    git remote add origin https://github.com/Consensys/teku.git && \
    git fetch --depth 1 origin 129f0ebd01010f45a86f18c5e8fe1c1d1012643f && \
    git checkout --detach FETCH_HEAD && \
    git submodule update --init --recursive --depth 1 2>/dev/null || true && \
    git remote remove origin && \
    git tag -l | xargs -r git tag -d && \
    git for-each-ref --format='%(refname)' refs/remotes refs/tags 2>/dev/null | xargs -r -n1 git update-ref -d && \
    git reflog expire --expire=now --all && \
    git gc --prune=now --aggressive && \
    rm -rf .git/logs .git/modules

WORKDIR /workspace/repo

RUN mkdir -p /root/.gradle && \
    printf 'org.gradle.jvmargs=-Xmx1g -Dfile.encoding=UTF-8 --add-exports jdk.compiler/com.sun.tools.javac.api=ALL-UNNAMED --add-exports jdk.compiler/com.sun.tools.javac.file=ALL-UNNAMED --add-exports jdk.compiler/com.sun.tools.javac.main=ALL-UNNAMED --add-exports jdk.compiler/com.sun.tools.javac.model=ALL-UNNAMED --add-exports jdk.compiler/com.sun.tools.javac.parser=ALL-UNNAMED --add-exports jdk.compiler/com.sun.tools.javac.processing=ALL-UNNAMED --add-exports jdk.compiler/com.sun.tools.javac.tree=ALL-UNNAMED --add-exports jdk.compiler/com.sun.tools.javac.util=ALL-UNNAMED --add-opens jdk.compiler/com.sun.tools.javac.code=ALL-UNNAMED --add-opens jdk.compiler/com.sun.tools.javac.comp=ALL-UNNAMED\n' > /root/.gradle/gradle.properties

RUN ./gradlew :beacon:validator:testClasses :infrastructure:async:testClasses :services:powchain:testClasses --no-daemon --no-watch-fs || true

WORKDIR /workspace

# OFFLINE-BAKE: warm gradle caches by running the test command at build time (with network)
RUN cat > /tmp/offline_warm.sh <<'OFFLINE_WARM_EOF_8f3a'
cd /workspace/repo && ./gradlew :beacon:validator:test :infrastructure:async:test :services:powchain:test --tests "*DepositProviderTest" --tests "*Eth1DataCacheTest" --tests "*Eth1DataProviderTest" --tests "*AsyncRunLoopTest" --tests "*PowchainServiceTest" --no-daemon --no-watch-fs && find /workspace/repo -name "TEST-*.xml" -path "*/build/test-results/test/*" -exec cat {} + 2>/dev/null
OFFLINE_WARM_EOF_8f3a
RUN cd /workspace/repo && (bash /tmp/offline_warm.sh 2>&1 | tail -40 || true)

# OFFLINE-BAKE: force gradle offline at test time (no network in sandbox)
RUN GUH="${GRADLE_USER_HOME:-$HOME/.gradle}" && mkdir -p "$GUH/init.d" && \
    printf 'gradle.startParameter.offline = true\n' > "$GUH/init.d/zzz-offline.gradle"

# --- offline-harbor: ensure grading(python3) + patch(patch/git) deps (build-time) ---
RUN (command -v python3 >/dev/null 2>&1 && command -v patch >/dev/null 2>&1 && command -v git >/dev/null 2>&1) \
    || (apt-get update && apt-get install -y --no-install-recommends python3 patch git ca-certificates) \
    || (apk add --no-cache python3 patch git ca-certificates) \
    || (dnf install -y python3 patch git ca-certificates) \
    || (yum install -y python3 patch git ca-certificates) \
    || true

# --- terminal-bench eval harness deps (tmux + asciinema), baked for offline eval ---
RUN (command -v tmux >/dev/null 2>&1 && command -v asciinema >/dev/null 2>&1) \
    || (apt-get update && apt-get install -y --no-install-recommends tmux asciinema) \
    || (apt-get update && apt-get install -y --no-install-recommends tmux python3-pip && pip3 install --no-cache-dir asciinema) \
    || (apk add --no-cache tmux asciinema) \
    || (dnf install -y tmux asciinema) \
    || (yum install -y tmux asciinema) \
    || true

# offline login-shell toolchain fix: bake $PATH into /etc/profile.d so `bash -lc` keeps toolchain on PATH

# dv01-blobdrop: shrink .git<100MB by dropping blob objects (working tree kept; grade uses patch -p1)
RUN cd /workspace/repo && \
    git cat-file --batch-all-objects --batch-check='%(objectname) %(objecttype)' 2>/dev/null | awk '$2!="blob"{print $1}' > /tmp/_nb.txt && \
    ( cat /tmp/_nb.txt | git pack-objects --non-empty /tmp/_gcpk ) && \
    rm -f .git/objects/pack/* && cp /tmp/_gcpk-*.pack /tmp/_gcpk-*.idx .git/objects/pack/ && \
    rm -f /tmp/_nb.txt /tmp/_gcpk-* && \
    (git reflog expire --expire=now --all 2>/dev/null || true) && rm -rf .git/logs && \
    (git remote remove origin 2>/dev/null || true) && (git tag -l | xargs -r git tag -d 2>/dev/null || true) && \
    (git gc --prune=now 2>/dev/null || true)

RUN printf 'export PATH="%s"\n' "$PATH" > /etc/profile.d/zzz_offline_path.sh && chmod 0644 /etc/profile.d/zzz_offline_path.sh
