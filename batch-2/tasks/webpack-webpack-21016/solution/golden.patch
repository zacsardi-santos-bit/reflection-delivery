+			for (let i = openElements.length - 1; i >= 0; i--) {
+				if (openElements[i].tagName === tagName) {
+					for (let j = i; j < openElements.length; j++) {
+						openElements[j].end = end;
+					}
+					openElements.splice(i);
+					break;
+				}
+			}
+
+			return end;
+		}
+	});
+
+	return doc;
+};
