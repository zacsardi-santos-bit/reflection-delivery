+				type: "element",
+				tagName,
+				namespace: getNamespace(tagName),
+				attributes: [...pendingAttrs],
+				children: [],
+				selfClosing: isVoid,
+				start,
+				end
+			};
+
+			pendingAttrs.length = 0;
+
+			currentChildren().push(element);
+
+			if (!isVoid) {
+				openElements.push(element);
+			}
