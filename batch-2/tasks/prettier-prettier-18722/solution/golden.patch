@@ -0,0 +1,41 @@
+#### Support Angular v21.2 (#18722, #19034 by @fisker)
+
+Exhaustive typechecking with `@default never;`
+
+<!-- prettier-ignore -->
+```html
+<!-- Input -->
+@switch (foo) {
+  @case (1) {}
+  @default never;
+}
+
+<!-- Prettier stable -->
+SyntaxError: Incomplete block "default never". If you meant to write the @ character, you should use the "&#64;" HTML entity instead. (3:3)
+
+<!-- Prettier main -->
+@switch (foo) {
+  @case (1) {}
+  @default never;
+}
+```
+
+`arrow function` and `instanceof` expressions.
+
+<!-- prettier-ignore -->
+```html
+<!-- Input -->
+@let fn = (a) =>        a?    1:2;
+
+{{ fn ( a         instanceof b)}}
+
+<!-- Prettier stable -->
+@let fn = (a) =>        a?    1:2;
+
+{{ fn ( a         instanceof b)}}
+
+<!-- Prettier main -->
+@let fn = (a) => (a ? 1 : 2);
+
+{{ fn(a instanceof b) }}
+```
