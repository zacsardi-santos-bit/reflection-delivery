+            processing_time=0.1,
+            documents=[
+                {
+                    "source_index": 0,
+                    "source_uri": "sample.pdf",
+                    "filename": "sample.pdf",
+                    "status": "failure",
+                    "errors": [server_error.model_dump()],
+                    "artifacts": [],
+                }
+            ],
+        )
+
+    def fake_download(self, uri):
+        raise AssertionError("must not download artifacts for a failed item")
