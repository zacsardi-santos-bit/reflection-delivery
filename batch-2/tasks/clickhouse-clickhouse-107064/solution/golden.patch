-
-
-def main(argv=None):
-    p = argparse.ArgumentParser(description=__doc__)
-    p.add_argument("--repo", required=True,
-                   help="Aggregator docs repo to shallow/sparse clone.")
-    p.add_argument("--ref", default="HEAD", help="Branch/tag/sha (default: HEAD).")
