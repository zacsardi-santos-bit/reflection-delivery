--- a/compiler-core/src/erlang.rs
+++ b/compiler-core/src/erlang.rs
@@ -1755,18 +1755,36 @@ fn const_inline<'a>(literal: &'a TypedConstant, env: &mut Env<'a>) -> Document<'
         }
 
         Constant::List { elements, tail, .. } => {
-            let tail_elements = tail
-                .as_deref()
