FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y \
    git curl ca-certificates openjdk-11-jdk maven \
    && rm -rf /var/lib/apt/lists/*

RUN mkdir -p /root/.m2 && cat > /root/.m2/settings.xml << 'EOF'
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0 http://maven.apache.org/xsd/settings-1.0.0.xsd">
  <profiles>
    <profile>
      <id>ctripcorp-repos</id>
      <repositories>
        <repository>
          <id>central</id>
          <url>https://repo1.maven.org/maven2</url>
        </repository>
        <repository>
          <id>unidal</id>
          <url>https://raw.github.com/ctripcorp/x-pipe/mvn_repo/</url>
          <releases>
            <checksumPolicy>ignore</checksumPolicy>
          </releases>
        </repository>
      </repositories>
      <pluginRepositories>
        <pluginRepository>
          <id>central</id>
          <url>https://repo1.maven.org/maven2</url>
        </pluginRepository>
        <pluginRepository>
          <id>unidal</id>
          <url>https://raw.github.com/ctripcorp/x-pipe/mvn_repo/</url>
          <releases>
            <checksumPolicy>ignore</checksumPolicy>
          </releases>
        </pluginRepository>
      </pluginRepositories>
    </profile>
  </profiles>
  <activeProfiles>
    <activeProfile>ctripcorp-repos</activeProfile>
  </activeProfiles>
</settings>
EOF

WORKDIR /workspace

RUN git init /workspace/repo && cd /workspace/repo && \
    git remote add origin https://github.com/ctripcorp/x-pipe.git && \
    git fetch --depth 30 origin e459c133363f38a67f145901e9ca031a960c6736 && \
    git checkout --detach FETCH_HEAD && \
    git submodule update --init --recursive --depth 1 2>/dev/null || true && \
    git remote remove origin && \
    git tag -l | xargs -r git tag -d && \
    git for-each-ref --format='%(refname)' refs/remotes refs/tags 2>/dev/null | xargs -r -n1 git update-ref -d && \
    git reflog expire --expire=now --all && \
    git gc --prune=now --aggressive && \
    rm -rf .git/logs

WORKDIR /workspace/repo

RUN sed -i '/com\.sun\.javafx/d' /workspace/repo/core/src/test/java/com/ctrip/xpipe/testutils/SpringApplicationStarter.java

RUN mvn -pl redis/redis-meta -am install -DskipTests || true

WORKDIR /workspace

# --- offline-harbor: ensure grading(python3) + patch(patch/git) deps (build-time) ---
RUN (command -v python3 >/dev/null 2>&1 && command -v patch >/dev/null 2>&1 && command -v git >/dev/null 2>&1) \
    || (apt-get update && apt-get install -y --no-install-recommends python3 patch git ca-certificates) \
    || (apk add --no-cache python3 patch git ca-certificates) \
    || (dnf install -y python3 patch git ca-certificates) \
    || (yum install -y python3 patch git ca-certificates) \
    || true

# --- terminal-bench eval harness deps (tmux + asciinema), baked for offline eval ---
RUN (command -v tmux >/dev/null 2>&1 && command -v asciinema >/dev/null 2>&1) \
    || (apt-get update && apt-get install -y --no-install-recommends tmux asciinema) \
    || (apt-get update && apt-get install -y --no-install-recommends tmux python3-pip && pip3 install --no-cache-dir asciinema) \
    || (apk add --no-cache tmux asciinema) || (dnf install -y tmux asciinema) || (yum install -y tmux asciinema) || true

# OFFLINE-M2-BAKE: warm ~/.m2 at build so the test runs offline (apply golden+test, warm, revert)
RUN set -e; \
    H="${HOME:-/root}"; \
    for hn in $(hostname) $(hostname -s 2>/dev/null) localhost; do \
      grep -qE "[[:space:]]$hn(\s|$)" /etc/hosts 2>/dev/null || echo "127.0.0.1 $hn" >> /etc/hosts; \
    done; \
    grep -q '::1' /etc/hosts 2>/dev/null || echo "::1 localhost ip6-localhost" >> /etc/hosts; \
    cd /workspace/repo; \
    echo "" | base64 -d > /tmp/_m2_golden.patch; \
    echo "" | base64 -d > /tmp/_m2_test.patch; \
    echo "Y2QgL3dvcmtzcGFjZS9yZXBvICYmIG12biAtcGwgcmVkaXMvcmVkaXMtbWV0YSB0ZXN0IC1EdGVzdD1EZWZhdWx0S2VlcGVyTWFuYWdlclRlc3QgLURmYWlsSWZOb1Rlc3RzPWZhbHNl" | base64 -d > /tmp/_m2_testcmd.sh; \
    (git apply --3way --ignore-whitespace /tmp/_m2_golden.patch 2>/dev/null \
      || git apply --ignore-whitespace --whitespace=nowarn /tmp/_m2_golden.patch 2>/dev/null \
      || patch -p1 --fuzz=5 -i /tmp/_m2_golden.patch 2>/dev/null || true); \
    (git apply --3way --ignore-whitespace /tmp/_m2_test.patch 2>/dev/null \
      || git apply --ignore-whitespace --whitespace=nowarn /tmp/_m2_test.patch 2>/dev/null \
      || patch -p1 --fuzz=5 -i /tmp/_m2_test.patch 2>/dev/null || true); \
    (cd /workspace/repo && mvn -B -fn -DskipTests -pl redis/redis-meta -am install -q >/dev/null 2>&1 || true); \
    (timeout 1500 bash /tmp/_m2_testcmd.sh 2>&1 | tail -20 || true); \
    cd /workspace/repo; \
    git checkout -- . 2>/dev/null || true; \
    git clean -fdq 2>/dev/null || true; \
    rm -f /tmp/_m2_golden.patch /tmp/_m2_test.patch /tmp/_m2_testcmd.sh

# OFFLINE-SIZE: drop submodule git-metadata + logs (after all build/submodule steps)
RUN cd /workspace/repo 2>/dev/null && (git gc --prune=now --aggressive 2>/dev/null || true) && rm -rf .git/modules .git/logs 2>/dev/null || true

# offline login-shell toolchain fix: bake $PATH into /etc/profile.d so `bash -lc` keeps toolchain on PATH
RUN printf 'export PATH="%s"\n' "$PATH" > /etc/profile.d/zzz_offline_path.sh && chmod 0644 /etc/profile.d/zzz_offline_path.sh
