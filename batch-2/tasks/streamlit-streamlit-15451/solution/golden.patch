new file mode 100644
index 0000000000..a5167f9049
--- /dev/null
+++ b/lib/streamlit/runtime/scriptrunner_utils/shared_run_state.py
@@ -0,0 +1,86 @@
+# Copyright (c) Streamlit Inc. (2018-2022) Snowflake Inc. (2022-2026)
+#
