-
-    g_raw = torch.randn(1, T, H, dtype=dtype, device=device)
-    g_triton = torch.nn.functional.logsigmoid(g_raw)
-    beta_triton = torch.sigmoid(torch.randn(1, T, H, dtype=dtype, device=device))
