-
-def _freqs_to_real(freqs_cis: torch.Tensor) -> torch.Tensor:
-    """Convert complex64 freqs to float32 [max_seq, rope_dim] interleaved."""
-    return torch.view_as_real(freqs_cis).flatten(-2).contiguous()
