-# Errors safe to retry while polling (transport-level only — HTTP 4xx/5xx
-# are intentionally NOT included so real regressions surface immediately).
-_TRANSIENT_ERRORS = (
-    httpx.TransportError,
-    httpx.TimeoutException,
-    ConnectionError,
-    OSError,
