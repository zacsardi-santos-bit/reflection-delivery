-        out.mkdir(parents=True, exist_ok=True)
-        print(f"\nLoading tokenizer for slug={slug}:", flush=True)
-        actual_hf_id, tok = load_tokenizer_with_fallback(primary, fallback, slug)
-        for shape, text in SHAPES.items():
