-name = "malachite-nz"
-allow = ["LGPL-3.0-only"]
-
-[[licenses.exceptions]]
-name = "malachite-q"
-allow = ["LGPL-3.0-only"]
-
-[[licenses.exceptions]]
-name = "malachite-bigint"
-allow = ["LGPL-3.0-only"]
-
