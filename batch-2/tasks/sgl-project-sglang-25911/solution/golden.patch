-impl CacheAwareZmqPolicy {
-    pub fn new(
-        config: CacheAwareConfig,
-        tree: Arc<HashTree>,
-        tokenizers: Arc<TokenizerRegistry>,
-        block_size_oracle: Arc<BlockSizeOracle>,
