-            .prefill_load
-            .fetch_add(prefill_load, Ordering::Relaxed);
-        counters
-            .decode_load
-            .fetch_add(decode_load, Ordering::Relaxed);
-        self.publish_gauge(&counters, &worker_url);
-        let cancel = CancellationToken::new();
-        self.requests.insert(
-            request_id.clone(),
-            RequestEntry {
-                worker: worker.clone(),
-                worker_url,
-                counters,
-                prefill_load,
-                decode_load,
-                registered_at: self.clock.now(),
-                cancel: cancel.clone(),
-            },
