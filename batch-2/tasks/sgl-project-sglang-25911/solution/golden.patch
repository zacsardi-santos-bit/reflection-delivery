-def bench_lifecycle(
-    seeds: list[list[int]],
-    n_decode: int,
-    iterations: int,
-    *,
-    ingest_fn: Callable[[list[int]], Any],
-    empty_fn: Callable[[], Any],
-    batch_torch_fn: Callable[[list[Any]], torch.Tensor],
-    warmup: int = 5,
-) -> dict[str, float]:
-    """Run simulate() N times, return mean per-stage us per batch.
