-                    return true;
-                }
-            }
-            tokio::time::sleep(Duration::from_millis(20)).await;
-        }
-    })
-    .await;
-    assert!(
-        resolved.is_ok(),
-        "expected mode=Prefill bootstrap_port=Some(8998); got {:?}",
-        registry.get(&id).map(|w| (w.mode(), w.bootstrap_port()))
