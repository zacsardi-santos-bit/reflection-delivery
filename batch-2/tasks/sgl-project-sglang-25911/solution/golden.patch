-    k = F.normalize(k.float(), p=2, dim=-1).to(dtype)
-    a = torch.randn(1, total_tokens, num_v_heads, device="cuda", dtype=dtype)
-    b = torch.randn(1, total_tokens, num_v_heads, device="cuda", dtype=dtype)
