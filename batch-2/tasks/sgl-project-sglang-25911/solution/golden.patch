-        let batch = decode_event_batch(&bytes).expect("decode");
-        assert_eq!(batch.events.len(), 3);
-        assert!(matches!(batch.events[0], KvCacheEvent::BlockStored(_)));
-        assert!(matches!(batch.events[1], KvCacheEvent::BlockRemoved(_)));
