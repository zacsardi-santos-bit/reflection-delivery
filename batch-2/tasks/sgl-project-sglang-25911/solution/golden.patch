-    total_tokens_bucket = named_args.get("total_tokens_bucket", 32)
-    if total_tokens_bucket > 8:
-        # Remove BLOCK_H=16 configs for large batch sizes
-        pruned = [c for c in configs if c.kwargs.get("BLOCK_H", 32) > 16]
-        if pruned:
-            return pruned
-    return configs
