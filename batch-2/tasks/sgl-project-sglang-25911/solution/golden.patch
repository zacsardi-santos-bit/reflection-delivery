-        B=B,
-        T=T,
-        T_per_seq=T_per_seq,
-        H=H,
-        K=K,
-        V=V,
-        pool_size=pool_size,
-        cache_indices=cache_indices,
-        pool_init=pool_init,
-        cu_seqlens=cu_seqlens,
-        q=q,
-        k=k,
