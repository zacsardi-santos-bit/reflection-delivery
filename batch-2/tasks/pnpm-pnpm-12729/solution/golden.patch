+}
+
+#[derive(Serialize)]
+struct ColdMockPackage {
+    access: &'static str,
+    publish: &'static str,
+    unpublish: &'static str,
+    proxy: &'static str,
+}
+
+#[derive(Serialize)]
+struct ColdMockLog {
