+        "time": {
+            "modified": "2026-06-21T12:00:00.000Z",
+            "1.0.0": "2026-06-20T12:00:00.000Z",
+            "1.1.0": "2026-06-21T12:00:00.000Z",
+        },
+        "versions": {
+            "1.0.0": {
+                "name": "foo",
+                "version": "1.0.0",
+                "dist": { "tarball": format!("{}/foo/-/foo-1.0.0.tgz", upstream.url()) },
+            },
+            "1.1.0": {
+                "name": "foo",
+                "version": "1.1.0",
+                "dist": { "tarball": format!("{}/foo/-/foo-1.1.0.tgz", upstream.url()) },
+            },
+        },
+    });
+    let mock = upstream
