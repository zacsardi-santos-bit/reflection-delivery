-  for (let idx = 0; idx < max; idx++) {
-    if (idx % 3 === 0 && idx) {
-      result += map[(bits >> 18) & 0x3f];
-      result += map[(bits >> 12) & 0x3f];
-      result += map[(bits >> 6) & 0x3f];
-      result += map[bits & 0x3f];
-    }
-
-    bits = (bits << 8) + object[idx];
-  }
-
-  // Dump tail
-
-  const tail = max % 3;
-
-  if (tail === 0) {
-    result += map[(bits >> 18) & 0x3f];
-    result += map[(bits >> 12) & 0x3f];
-    result += map[(bits >> 6) & 0x3f];
-    result += map[bits & 0x3f];
-  } else if (tail === 2) {
