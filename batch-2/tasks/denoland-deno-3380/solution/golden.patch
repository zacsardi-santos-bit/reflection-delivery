-  let code: number;
-  let bitlen = 0;
-  const max = data.length;
-  const map = BASE64_MAP;
-
-  // Convert one by one.
-  for (let idx = 0; idx < max; idx++) {
-    code = map.indexOf(data.charAt(idx));
-
-    // Skip CR/LF
-    if (code > 64) continue;
-
-    // Fail on illegal characters
-    if (code < 0) return false;
-
-    bitlen += 6;
-  }
-
-  // If there are any bits left, source was corrupted
-  return bitlen % 8 === 0;
