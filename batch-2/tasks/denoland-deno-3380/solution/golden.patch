-  if (value === ".inf") {
-    return sign === 1 ? Number.POSITIVE_INFINITY : Number.NEGATIVE_INFINITY;
-  }
-  if (value === ".nan") {
-    return NaN;
-  }
-  if (value.indexOf(":") >= 0) {
-    value.split(":").forEach((v): void => {
-      digits.unshift(parseFloat(v));
-    });
