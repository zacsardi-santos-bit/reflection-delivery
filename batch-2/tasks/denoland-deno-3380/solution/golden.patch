-    result += map[(bits >> 4) & 0x3f];
-    result += map[(bits << 2) & 0x3f];
-    result += map[64];
-  } else if (tail === 1) {
-    result += map[(bits >> 2) & 0x3f];
-    result += map[(bits << 4) & 0x3f];
-    result += map[64];
-    result += map[64];
