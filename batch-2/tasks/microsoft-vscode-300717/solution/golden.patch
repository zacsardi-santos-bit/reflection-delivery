+		displayLabel: rawValue,
+		cloneUrl: rawValue,
+		canonicalId: `git:${uri.authority.toLowerCase()}/${canonicalPath}`,
+		cacheSegments: [sanitizedAuthority, ...pathSegments],
+		kind: MarketplaceReferenceKind.GitUri,
+	};
