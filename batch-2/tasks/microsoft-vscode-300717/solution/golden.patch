-					break;
-				}
-			}
-
-			if (stepPassed) {
-				console.log(`  ✅ ${label}`);
-				totalPassed++;
-			}
-		}
-
-		console.log();
-	}
-
-	cleanup(server);
-
-	console.log(`Results: ${totalPassed} passed, ${totalFailed} failed`);
