+		const localRepositoryUri = URI.file(uri.fsPath);
+		return {
+			rawValue,
+			displayLabel: localRepositoryUri.fsPath,
+			cloneUrl: rawValue,
+			canonicalId: `file:${localRepositoryUri.toString().toLowerCase()}`,
+			cacheSegments: [],
