-
-function commandsPathForScenario(scenarioPath) {
-	const dir = path.join(path.dirname(scenarioPath), 'generated');
-	const name = path.basename(scenarioPath, '.scenario.md') + '.commands.json';
-	return path.join(dir, name);
-}
