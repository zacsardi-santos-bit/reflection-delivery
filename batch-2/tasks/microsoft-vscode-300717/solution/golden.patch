-	let lastResult = checkFn();
-	while (!lastResult.ok && Date.now() < deadline) {
-		cp.spawnSync('sleep', [(ASSERT_POLL_MS / 1000).toString()]);
-		lastResult = checkFn();
-	}
-	return lastResult;
-}
