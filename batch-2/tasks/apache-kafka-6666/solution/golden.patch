-        case Some(requests) => requests
-          .filter(_.request.apiKey == ApiKeys.LEADER_AND_ISR)
-          .map(_.request.build(version).asInstanceOf[LeaderAndIsrRequest]).toList
-        case None => List.empty[LeaderAndIsrRequest]
-      }
-    }
