-            String line = lines.get(lineNumber - 1).trim();
-            if (line.isEmpty()) {
-                continue;
-            }
-
-            List<String> parts = LINE_SPLITTER.splitToList(line);
-            if (parts.size() != 2) {
-                throw invalidFile(lineNumber, "Expected two parts for user and password", null);
-            }
-            String user = parts.get(0);
