+            "versions": {
+                "1.0.0": { "version": "1.0.0", "dependencies": {} }
+            },
+            "dist-tags": { "latest": "1.0.0" },
+            "time": { "1.0.0": "2024-01-01T00:00:00.000Z" }
+        });
+        let incoming = json!({
+            "name": "foo",
+            "versions": {
+                "1.1.0": { "version": "1.1.0" }
+            },
+            "dist-tags": { "latest": "1.1.0" }
+        });
