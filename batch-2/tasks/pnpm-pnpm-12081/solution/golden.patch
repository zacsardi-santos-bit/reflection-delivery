+    fn pair(name: &str, version: &str) -> PeerId {
+        PeerId::Pair { name: name.to_string(), version: version.to_string() }
+    }
+
+    #[test]
+    fn empty_input_renders_a_single_pair_of_parens() {
+        let got = create_peer_dep_graph_hash(&[], 1000);
