+        set_fake_env(&[("npm_config_userconfig", npm_file.to_str().unwrap())]);
+        let config = load_with_fake_env(project.path());
+        assert_eq!(
+            config.auth_headers.for_url("https://npm.example.com/pkg").as_deref(),
+            Some("Bearer npm-token"),
+        );
