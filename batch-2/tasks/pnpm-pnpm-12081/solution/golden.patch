+        // Regression for pnpm #11533: the tarball must not embed
+        // `%2F`. The `/-/archive/<ref>/<project>-<ref>.tar.gz` form
+        // doesn't.
+        let mut h = HostedGit::from_url("gitlab:pnpmjs/git-resolver").expect("ok");
