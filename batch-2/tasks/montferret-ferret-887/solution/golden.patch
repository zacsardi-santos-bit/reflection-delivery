+func (e *engine) inlineFitsWith(p *printer, inline string) bool {
+	if p == nil {
+		return len(inline) <= int(e.opts.printWidth)
+	}
+
+	column := p.currentColumn()
+
+	if p.atLineStart {
+		column += int(p.opts.tabWidth) * p.indent
+	}
+
+	return column+len(inline) <= int(e.opts.printWidth)
+}
